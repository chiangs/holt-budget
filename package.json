{
  "name": "holt-budget",
  "private": true,
  "description": "Holt: a household budget planner for Linux, with a local AI assistant. Nothing leaves your computer.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens": "node packages/ui/scripts/build-tokens.mjs",
    "lint:colours": "node scripts/check-colours.mjs",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @holt/desktop dev",
    "build": "pnpm tokens && pnpm --filter @holt/desktop build",
    "dist": "pnpm build && pnpm --filter @holt/desktop dist",
    "eval": "node tools/eval/run.ts",
    "lint:network": "node scripts/check-network.mjs",
    "lint:strings": "node scripts/check-strings.mjs",
    "test:e2e": "playwright test -c apps/desktop/playwright.config.ts",
    "test:no-network": "bash scripts/no-network.sh",
    "test:packaging": "bash scripts/check-packaging.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/parser": "^8.1.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
